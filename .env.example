# ---------------------------------------------------------------------------
# Local development: copy this file to `.env.local`.
# Vercel: add each of these under Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# --- Auth.js (NextAuth v5) -------------------------------------------------
# REQUIRED. Signs the session JWT. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace_me_with_openssl_rand_base64_32"

# Canonical public URL of the deployment. It determines the OAuth redirect_uri
# that Auth.js sends to Facebook, so it MUST match the Meta dashboard entry.
#   production -> https://fb-ai-tau.vercel.app
#   local      -> http://localhost:3000
# Note: on Vercel this is optional (the platform is auto-detected), but setting
# it pins the callback to your production domain instead of the per-deployment
# preview URL, which is what Facebook requires.
NEXTAUTH_URL="https://fb-ai-tau.vercel.app"

# Aliases kept for compatibility - AUTH_* is the v5 name, NEXTAUTH_* the v4 one.
# AUTH_URL="https://fb-ai-tau.vercel.app"
# NEXTAUTH_SECRET="same_value_as_AUTH_SECRET"

# --- Facebook Login --------------------------------------------------------
# From https://developers.facebook.com/apps > your app > Settings > Basic.
# In "Facebook Login > Settings", add this EXACT Valid OAuth Redirect URI:
#   https://fb-ai-tau.vercel.app/api/auth/callback/facebook
# Required for the real Facebook OAuth button and Graph API Page import.
AUTH_FACEBOOK_ID="your_facebook_app_id"
AUTH_FACEBOOK_SECRET="your_facebook_app_secret"

# Optional compatibility aliases.
FACEBOOK_CLIENT_ID="your_facebook_app_id"
FACEBOOK_CLIENT_SECRET="your_facebook_app_secret"
NEXT_PUBLIC_FACEBOOK_APP_ID="your_facebook_app_id"

# --- Database --------------------------------------------------------------
# Providers: Neon, Supabase, Railway, Render, CockroachDB, AWS RDS, ...
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialai_db"

# --- Application -----------------------------------------------------------
# AES-256 key used to encrypt stored Page access tokens.
ENCRYPTION_SECRET="socialai_production_encryption_secret_key_32_bytes_long!!"

NEXT_PUBLIC_APP_URL="https://fb-ai-tau.vercel.app"

# --- Optional integrations -------------------------------------------------
OPENAI_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PREMIUM_MONTHLY_PRICE_ID=""

# Set to "true" ONCE to insert the demo dataset (idempotent), then unset.
SEED_DEMO_DATA="false"
