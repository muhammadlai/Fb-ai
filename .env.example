# ---------------------------------------------------------------------------
# Local development (`bun run dev`) reads this file when copied to `.env.local`.
#
# On Cloudflare Workers these are NOT read from a file. Set them as secrets:
#   bunx wrangler secret put DATABASE_URL
#   bunx wrangler secret put ENCRYPTION_SECRET
#   ...
# or via the dashboard: Workers & Pages > your worker > Settings > Variables.
# Non-secret values may instead go in the [vars] block of wrangler.toml.
# ---------------------------------------------------------------------------

# PostgreSQL Connection String (Required at runtime)
# Providers: Neon, Supabase, Railway, Render, CockroachDB, AWS RDS, ...
# On Workers, prefer a Cloudflare Hyperdrive binding (see wrangler.toml) so
# connections are pooled at the edge. When the HYPERDRIVE binding exists it
# takes precedence over DATABASE_URL automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialai_db"

# Secret Key for AES-256 Access Token Encryption (Required at runtime)
ENCRYPTION_SECRET="socialai_production_encryption_secret_key_32_bytes_long!!"

# Application Base URL (Required for OAuth Redirects & Stripe Callbacks)
NEXT_PUBLIC_APP_URL="https://your-worker.workers.dev"

# Meta (Facebook) OAuth Application Credentials
NEXT_PUBLIC_FACEBOOK_APP_ID="782910384759201"
FACEBOOK_APP_SECRET="your_facebook_app_secret_here"

# OpenAI API Key for AI Post Generation (Optional - Smart Fallback Engine included)
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Stripe Payment Integration Secrets (Optional - Simulated Checkout mode active if omitted)
STRIPE_SECRET_KEY="sk_test_51..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_1..."
STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_2..."

# Set to "true" ONCE to insert the demo dataset (idempotent), then unset.
# Never leave enabled in production.
SEED_DEMO_DATA="false"
