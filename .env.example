# PostgreSQL Database Connection String (Required at runtime)
# Supported Providers: Neon, Supabase, Railway, Render, CockroachDB, AWS RDS, or any PostgreSQL instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialai_db"

# Secret Key for AES-256 Access Token Encryption (Required at runtime)
ENCRYPTION_SECRET="socialai_production_encryption_secret_key_32_bytes_long!!"

# Application Base URL (Required for OAuth Redirects & Stripe Callbacks)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Meta (Facebook) OAuth Application Credentials
NEXT_PUBLIC_FACEBOOK_APP_ID="782910384759201"
FACEBOOK_APP_SECRET="your_facebook_app_secret_here"

# OpenAI API Key for AI Post Generation (Optional - Smart Fallback Engine included)
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Stripe Payment Integration Secrets (Optional - Simulated Checkout mode active if omitted)
STRIPE_SECRET_KEY="sk_test_51..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_1..."
STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_2..."
